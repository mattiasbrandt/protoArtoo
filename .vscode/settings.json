{
    // =========================================================================
    // protoArtoo — VS Code workspace settings
    //
    // Shared project settings committed to the repo. Personal overrides
    // (font size, theme, keybindings) belong in User Settings, not here.
    // =========================================================================

    // --- C/C++ formatting -----------------------------------------------
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.rulers": [100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    // --- C/C++ language settings --------------------------------------------
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 4
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true,
        "editor.tabSize": 4
    },

    // --- Web UI assets (data/ folder) — HTML/JS/CSS -------------------------
    "[html]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[javascript]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    "[css]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },

    // --- JSON / Markdown ----------------------------------------------------
    "[json]": {
        "editor.tabSize": 2
    },
    "[jsonc]": {
        "editor.tabSize": 2
    },
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.rulers": [80]
    },

    // --- File associations --------------------------------------------------
    "files.associations": {
        "*.h": "cpp",
        "*.ino": "cpp",
        "secrets.h": "cpp"
    },

    // --- File hygiene -------------------------------------------------------
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,

    // Exclude build artifacts and generated files from search/explorer
    "files.exclude": {
        "**/.pio": true,
        "**/.git": true,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/.pio": true,
        "**/node_modules": true,
        "**/*.map": true
    },

    // --- PlatformIO ---------------------------------------------------------
    // PlatformIO manages its own IntelliSense via c_cpp_properties.json.
    // If you see squiggles on ESP32/Arduino headers, run:
    //   PlatformIO: Rebuild IntelliSense Index (Ctrl+Shift+P)
    "C_Cpp.default.configurationProvider": "platformio.platformio-ide",

    // Ignore compile_commands.json — the Xtensa cross-compiler flags in it
    // confuse the built-in clang IntelliSense engine. PlatformIO's own
    // c_cpp_properties.json (configurationProvider above) is the correct source.
    "C_Cpp.default.compileCommands": "",

    // The MS C/C++ IntelliSense engine cannot resolve Xtensa cross-compiled
    // ESP32 code correctly (missing machine/endian.h, HardwareSerial type
    // errors, etc.). These are all false positives — pio run compiles cleanly.
    // Disable error squiggles; keep navigation and autocomplete.
    "C_Cpp.intelliSenseEngine": "Tag Parser",
    "C_Cpp.errorSquiggles": "disabled",

    // --- Spell checker (project dictionary) ---------------------------------
    "cSpell.words": [
        "protoArtoo",
        "AstroPixels",
        "Marcduino",
        "hoverboard",
        "astromech",
        "SBUS",
        "LEDC",
        "TWDT",
        "NVS",
        "estop",
        "failsafe",
        "portMUX",
        "FreeRTOS",
        "softserial",
        "baudrate"
    ],

    // --- Terminal defaults ---------------------------------------------------
    "terminal.integrated.defaultProfile.linux": "zsh"
}
