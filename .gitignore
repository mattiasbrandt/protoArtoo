# PlatformIO Core
.pio
.pioenvs
.piolibdeps
.piolib
.pio-build/

# Arduino/ESP32 build artifacts
*.elf
*.bin
*.hex
*.uf2
*.o
*.a
*.d
build/


# General temp and backup files
*~
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db
*.log

# LLM agent temp files, tasks, and todos
*.agent
agent_*
llm_*
/tasks/
todos/
todo.md
task.md
*.todo
*.task
*.tmp.llm
.sisyphus/

# Agent working directories (environment-specific)
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/hooks/
!.claude/hooks/**
!.claude/verification-playbook.md
.clangd
.omp/mcp.json
.playwright-mcp/

# Playwright/browser session temp files dumped in repo root
/*.png
/rc-snap*.md
/rc-snapshot.md

# Python/virtualenv (if using scripts or tools)
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
*.egg
venv/
.env

# Editor/IDE specifics
.idea/
*.iml
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/*.code-workspace

# PlatformIO compilation database (auto-generated, env-specific)
compile_commands.json

# Secrets — WiFi credentials, never commit
src/secrets.h

# Local build overrides — generated by tools/configure.py (make setup)
user.mk

# pioarduino custom_sdkconfig build artifacts — generated during the Arduino
# core lib rebuild; sdkconfig.defaults carries the builder's hash stamp
sdkconfig.defaults
sdkconfig.artoo_esp32*
sdkconfig.firebeetle2*
src/idf_component.yml
managed_components/
.dummy/
# Emitted at project root by the ESP-IDF component-manager path (P4 builds hit
# this via custom_sdkconfig). CMakeLists.txt is generated per checkout — its
# project() name is the containing directory, so a worktree build writes a
# different one than the main checkout.
CMakeLists.txt
dependencies.lock

# Misc
# node_modules/ — ignored when JS tooling (e.g. playwright) is installed
node_modules/
