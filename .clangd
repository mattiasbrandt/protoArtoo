# .clangd — project-level clangd configuration
#
# This project targets ESP32 via PlatformIO + Arduino framework. The Xtensa
# cross-compiler toolchain and Arduino.h are only available inside the pio
# build environment, so clangd cannot resolve them from the host system.
#
# PlatformIO's c_cpp_properties.json (via C_Cpp.default.configurationProvider)
# is the authoritative IntelliSense source. Clangd is kept for navigation and
# auto-complete but its diagnostics are suppressed to avoid false positives.

Diagnostics:
  Suppress:
    - pp_file_not_found    # Arduino.h / ESP-IDF headers not on host include path
    - unknown_typename        # uint8_t, uint16_t etc. from missing stdint.h chain
    - unknown_typename_suggest  # same as above but clang emits a 'did you mean' suggestion variant
    - missing_exception_spec
    - undeclared_var_use         # enum values / symbols from ESP-IDF/Arduino/FreeRTOS chain invisible to host clangd
    - undeclared_var_use_suggest # same as above but clang emits a 'did you mean' suggestion variant
    - expected_expression  # C-style cast (type*) fails when type is unknown due to missing ESP-IDF headers
    - fatal_too_many_errors  # cascade sentinel; clang stops before suppressions apply without the limit removed
    - unused-includes        # false positive: Arduino.h/FreeRTOS headers missing on host hide inline fn bodies
    - template_kw_missing    # false positive: ArduinoJson .add<T>()/.to<T>() template calls on dependent types
    - expected_class_name    # false positive: cascades from Arduino.h String not resolved in test stub path
    - override_keyword_only_allowed_on_virtual_member_functions  # false positive: cascades from expected_class_name above
    - sizeof_alignof_incomplete_or_sizeless_type  # false positive: constexpr array with deduced size in same TU

CompileFlags:
  Add:
    - "-ferror-limit=0"  # prevent clang from bailing before individual false-positive suppressions apply
